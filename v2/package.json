{
  "name": "knowledge-systems-v2-exploration",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/finalize-pages-build.ts",
    "capture:observatory": "node scripts/capture-observatory.ts",
    "capture:review": "node scripts/capture-review.ts",
    "preview": "vite preview --base /Knowledge_System/",
    "preview:test": "vite preview --base /",
    "test": "vite build --mode test && playwright test",
    "validate:model": "node scripts/validate-model.ts",
    "validate:themes": "node scripts/validate-themes.ts",
    "verify:pages": "node scripts/verify-pages-preview.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
